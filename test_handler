from music_handler import MusicHandler
import json

def print_song(song, label="Song"):
    """Pretty print song info"""
    if song:
        print(f"\n{'='*50}")
        print(f"{label}:")
        print(f"{'='*50}")
        print(f"Title: {song.get('title')}")
        print(f"Duration: {song.get('duration')} seconds")
        print(f"Source: {song.get('source')}")
        print(f"Stream URL: {song.get('url')[:50]}...")
        print(f"Webpage URL: {song.get('webpage_url')}")
        if song.get('original_title'):
            print(f"Original (Spotify): {song.get('original_title')}")
        print(f"{'='*50}\n")
    else:
        print(f"\n❌ Failed to get {label}\n")

def test_youtube():
    """Test YouTube functionality"""
    print("\n" + "🎵 TESTING YOUTUBE FUNCTIONALITY " + "="*30)
    
    handler = MusicHandler()
    
    # Test 1: Direct YouTube URL
    print("\n📺 Test 1: Direct YouTube URL")
    youtube_url = "https://www.youtube.com/watch?v=dQw4w9WgXcQ"
    song = handler.get_song(youtube_url)
    print_song(song, "Direct YouTube URL")
    
    # Test 2: YouTube search
    print("\n🔍 Test 2: YouTube Search")
    search_url = "ytsearch:never gonna give you up"
    song = handler.get_song(search_url)
    print_song(song, "YouTube Search Result")
    
    # Test 3: Verify song format
    if song:
        print("\n✅ Checking song format...")
        required_keys = ['title', 'url', 'duration', 'source', 'webpage_url']
        for key in required_keys:
            if key in song:
                print(f"  ✓ {key}: Present")
            else:
                print(f"  ✗ {key}: MISSING!")
        
        # Check if thumbnail is present (optional)
        if 'thumbnail' in song:
            print(f"  ✓ thumbnail: Present (optional)")

def test_spotify():
    """Test Spotify functionality"""
    print("\n" + "🎵 TESTING SPOTIFY FUNCTIONALITY " + "="*30)
    
    handler = MusicHandler()
    
    if not handler.spotify:
        print("\n⚠️  Spotify not configured. Skipping Spotify tests.")
        print("To enable Spotify:")
        print("1. Go to https://developer.spotify.com/dashboard")

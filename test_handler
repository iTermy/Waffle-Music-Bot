        print("3. Add credentials to .env file:")
        print("   SPOTIFY_CLIENT_ID=your_id")
        print("   SPOTIFY_CLIENT_SECRET=your_secret")
        return
    
    # Test 4: Spotify track
    print("\n🎧 Test 4: Spotify Track")
    spotify_url = "https://open.spotify.com/track/4cOdK2wGLETKBW3PvgPWqT"
    song = handler.get_song(spotify_url)
    print_song(song, "Spotify Track (converted to YouTube)")
    
    # Test 5: Verify it's marked as Spotify source
    if song:
        if song.get('source') == 'spotify':

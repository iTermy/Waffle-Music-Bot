"""
Unit tests for music_handler.py - No network required
Tests code structure and logic without making real API calls
"""

from music_handler import MusicHandler
import inspect

def test_class_structure():
    """Test that MusicHandler has all required methods"""
    print("\n" + "="*60)
    print("✅ Testing MusicHandler class structure")
    print("="*60)
    
    handler = MusicHandler()
    
    # Check required methods exist
    required_methods = [
        'get_youtube_info',
        'get_spotify_info',
        'spotify_to_youtube',
        'get_song',
        'get_playlist'
    ]
    
    for method in required_methods:
        if hasattr(handler, method):
            print(f"  ✓ Method '{method}' exists")
        else:
            print(f"  ✗ Method '{method}' MISSING!")
    
    print()

def test_song_format():
    """Test that methods return correct format (mocked)"""
    print("="*60)
    print("✅ Testing song data format")
    print("="*60)
    
    # Expected format
    expected_keys = ['title', 'url', 'duration', 'source', 'webpage_url']
    optional_keys = ['thumbnail', 'original_title']
    
    print("\nExpected format:")
    print("{")
    for key in expected_keys:
        print(f"    '{key}': <value>,  # Required")
    for key in optional_keys:
        print(f"    '{key}': <value>,  # Optional")
    print("}")
    
    print("\n✅ Format specification confirmed")
    print()

def test_url_detection():
    """Test URL type detection logic"""
    print("="*60)
    print("✅ Testing URL type detection")
    print("="*60)
    
    test_urls = [
        ("https://www.youtube.com/watch?v=dQw4w9WgXcQ", "YouTube"),
        ("https://youtu.be/dQw4w9WgXcQ", "YouTube"),
        ("https://open.spotify.com/track/4cOdK2wGLETKBW3PvgPWqT", "Spotify"),
        ("https://open.spotify.com/playlist/37i9dQZF1DXcBWIGoYBM5M", "Spotify Playlist"),
    ]
    
    for url, expected_type in test_urls:
        if 'spotify.com' in url:
            if 'playlist' in url:
                result = "Spotify Playlist"
            else:
                result = "Spotify"
        else:
            result = "YouTube"
        
        if result == expected_type:
            print(f"  ✓ Correctly identifies: {expected_type}")
        else:
            print(f"  ✗ Misidentified: {url}")
    
    print()

def test_initialization():
    """Test MusicHandler initialization"""
    print("="*60)
    print("✅ Testing MusicHandler initialization")
    print("="*60)
    
    handler = MusicHandler()
    
    # Check attributes
    if hasattr(handler, 'ydl_opts'):
        print("  ✓ YouTube downloader options configured")
    
    if hasattr(handler, 'spotify'):
        print("  ✓ Spotify client attribute exists")
        if handler.spotify is None:
            print("    (Spotify not configured - this is OK)")
        else:
            print("    (Spotify configured)")
    
    print()

def test_method_signatures():
    """Test that methods have correct signatures"""
    print("="*60)
    print("✅ Testing method signatures")
    print("="*60)
    
    handler = MusicHandler()
    
    # Check get_song signature
    sig = inspect.signature(handler.get_song)
    params = list(sig.parameters.keys())
    if 'url' in params:
        print("  ✓ get_song(url) - Correct signature")
    else:
        print("  ✗ get_song() - Wrong signature!")
    
    # Check get_playlist signature
    sig = inspect.signature(handler.get_playlist)
    params = list(sig.parameters.keys())
    if 'url' in params:
        print("  ✓ get_playlist(url) - Correct signature")
    else:
        print("  ✗ get_playlist() - Wrong signature!")
    
    print()

def main():
    """Run all unit tests"""
    print("\n" + "="*60)
